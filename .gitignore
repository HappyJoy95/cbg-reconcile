# 会话与凭据：绝不入库
.secrets/
*.env
config/store-*.local.yaml
# 门店自己的配置：**这台电脑的**，不进仓库也不进包。
# 安装时由 bootstrap.ensure_layout() 从 src/store-config.default.yaml 生成。
# ⚠ 以前这个文件是跟踪的（拿它当「默认配置」发出去）—— 那会让手工拷贝/装包
#   把门店已经填好的配置冲掉。现在只发模板。
config/store-*.yaml

# 运行产物
out/
!out/.gitkeep
# 门店自己传的壁纸（web/wallpaper/）—— 不进仓库也不进包；升级不带走
web/wallpaper/*
!web/wallpaper/.gitkeep
# ⚠ `in/` = **收进来的**东西（各店发来的上报包 / 收信库）——
#   跟 out/ 一起属于"这台电脑自己的"，不进仓库（用户 2026-09-21 定的布局）。
in/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# 打包产物
dist/

# 构建指纹：打包时由 tools/build_package.sh 写，clone 部署时由
# bootstrap.py install 从 .git 补一个 —— 两种都是本机生成，不入库
BUILD.txt

# 安装时按本机生成的运行脚本（里面是**这台电脑**的 Python 绝对路径）
# run_check.py 不一样 —— 那是源码，要提交
run.sh
run.bat
run-now.sh
run-now.bat

# macOS
.DS_Store

# DSH 隔离区：记忆/临时任务/归档/备份/文档，在库里但不进版本库
.dsh/

# 本机临时 / 预览 / 源表 —— 不进仓库也不进包
# （根目录 claim-guide* 是 web/ 下正式页的预览副本；xlsx 是逆推源表）
.playwright-cli/
claim-guide-preview.html
claim-guide.css
claim-guide.js
*.xlsx
!web/tools/**/*
!**/*.sample.xlsx

# 打包时注入的中台邮箱授权码（由 build_package.sh 生成，只进包不进仓库）
central-mail.env

# 打包时注入的邮件附件加密密钥（由 build_package.sh 从 .secrets/mail-key.json
# 读出来塞进包根，安装时播种进门店的 .secrets/）。
# ⚠⚠ 仓库是**公开**的（自更新匿名读 api.github.com）—— 这个文件进来一次，
#    附件加密就当场归零。`.secrets/` 那条已经挡住本机那份了，这一行挡的是
#    **包根那份**：它散装在仓库根目录，不写就会裸奔。
mail-key.json
dist-exe/
